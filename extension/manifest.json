{
  "manifest_version": 3,
  "name": "Foxbook Control",
  "version": "0.1.0",
  "description": "Foxbook のシステム操作画面",
  "browser_specific_settings": {
    "gecko": {
      "id": "foxbook-control@foxbook.example"
    }
  },
  "permissions": ["nativeMessaging"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Foxbook Control を開く"
  }
}
