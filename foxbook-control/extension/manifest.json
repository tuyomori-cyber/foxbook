{
  "manifest_version": 3,
  "name": "Foxbook Control",
  "version": "0.1.0",
  "description": "Foxbook のシステム操作画面",
  "icons": {
    "16": "icons/foxbook-control-16.png",
    "32": "icons/foxbook-control-32.png",
    "48": "icons/foxbook-control-48.png",
    "96": "icons/foxbook-control-96.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "foxbook-control@foxbook.example",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["nativeMessaging"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Foxbook Control を開く",
    "default_icon": {
      "16": "icons/foxbook-control-16.png",
      "32": "icons/foxbook-control-32.png"
    }
  }
}
